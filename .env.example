# Copy to .env. Only the make targets read it (Makefile "include .env"); docker compose and direct python
# commands do not, so export the variables in your shell for those. Everything is optional in local mode.
# See Documents/configuration.md for the full list.

DOCINTEL_MODE=local             # local | azure (sets the default of every backend below)

# --- Use the real Azure AI Document Intelligence from your machine (storage stays a local folder) -----------
# ANALYZE_BACKEND=azure
# DOCINTEL_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
# DOCINTEL_KEY=<key>            # developer machines only; omit to use your az login (DefaultAzureCredential)

# --- Use Azure Blob Storage, or Azurite -------------------------------------------------------------------
# STORAGE_BACKEND=azure
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true     # Azurite

# --- Web app ---------------------------------------------------------------------------------------------
# AUTH_MODE=dev                 # dev (choose a role, local mode only) | password
# DEMO_PASSWORD=                # needed when AUTH_MODE=password
# DJANGO_DEBUG=true             # Django debug pages (developer machines only)
# MOCK_ANALYZE_DELAY=0.8        # seconds the mock analyzer waits, so the UI shows "Processing"
# REVIEW_THRESHOLD=0.80
# DAILY_PAGE_LIMIT=200
# MAX_UPLOAD_MB=10
# MAX_PAGES=10
