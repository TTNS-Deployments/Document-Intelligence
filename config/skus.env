# ==============================================================================
# skus.env - SKU, tier, capacity and limit inputs for the Document Intelligence stack
#
# Edit this file to size the deployment. deploy.sh reads it, so you never need to touch
# the ARM templates to change a SKU. Use a different file with:
#   SKU_FILE=/path/to/other.env ./deploy.sh
#
# Values are plain shell assignments (no spaces around "=").
# Check current pricing and regional availability before deploying:
#   https://azure.microsoft.com/en-us/pricing/calculator/
# ==============================================================================

# ---------- Azure Document Intelligence ----------
# One account serves both prebuilt and custom models.
# Valid: S0 (pay as you go), F0 (free, 500 pages per month, limited to 1 per subscription)
DOCINT_SKU="S0"

# ---------- VPN Gateway ----------
# Valid: VpnGw1AZ to VpnGw5AZ (use these). VpnGw1 to VpnGw5 without "AZ" can no longer be
# created for new gateways, so the VpnGw1 tier in the original estimate is deployed as VpnGw1AZ.
# Billed per hour whether or not anything is connected, and slow to create (30 to 45 minutes).
VPN_GATEWAY_SKU="VpnGw1AZ"
# Valid: Generation1, Generation2 (Generation2 needs VpnGw2AZ or above)
VPN_GATEWAY_GENERATION="Generation1"

# ---------- Azure Functions ----------
# Y1 is the Consumption plan. The Linux Consumption plan retires on 30 September 2028;
# plan a move to Flex Consumption before then.
FUNCTION_PLAN_SKU="Y1"
# Linux runtime stack. The function code in functions/ is written for Python 3.11.
FUNCTION_RUNTIME="Python|3.11"

# ---------- API Management ----------
# Valid: Consumption. Capacity is always 0 on the Consumption tier.
APIM_SKU="Consumption"
APIM_CAPACITY=0

# ---------- Storage Account ----------
# Valid: Standard_LRS, Standard_ZRS, Standard_GRS, Standard_RAGRS, Standard_GZRS, Standard_RAGZRS
STORAGE_SKU="Standard_LRS"
# Valid: Hot, Cool
STORAGE_ACCESS_TIER="Hot"

# ---------- Limits and behavior (not SKUs, but kept here so one file controls sizing) ----------
# Largest file the upload page and the API accept, in MB (1 to 100).
MAX_UPLOAD_MB=20
# API calls allowed per minute for each API Management subscription key.
APIM_RATE_LIMIT_CALLS_PER_MIN=30
# Model preselected in the upload page.
DEFAULT_MODEL="prebuilt-invoice"
# Models listed in the upload page (comma-separated). Add your custom model IDs here.
AVAILABLE_MODELS="prebuilt-invoice,prebuilt-receipt,prebuilt-idDocument,prebuilt-layout,prebuilt-read"
# Fields with confidence below this value are flagged "Review" in the upload page (0 to 1).
REVIEW_THRESHOLD=0.8
