{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "1466351964551774119"
    }
  },
  "parameters": {
    "namePrefix": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "gatewaySku": {
      "type": "string",
      "defaultValue": "VpnGw1AZ",
      "allowedValues": [
        "VpnGw1AZ",
        "VpnGw2AZ",
        "VpnGw3AZ",
        "VpnGw4AZ",
        "VpnGw5AZ",
        "VpnGw1",
        "VpnGw2",
        "VpnGw3",
        "VpnGw4",
        "VpnGw5"
      ]
    },
    "gatewayGeneration": {
      "type": "string",
      "defaultValue": "Generation1",
      "allowedValues": [
        "Generation1",
        "Generation2"
      ]
    },
    "gatewaySubnetId": {
      "type": "string"
    }
  },
  "variables": {
    "tags": {
      "project": "[parameters('namePrefix')]",
      "environment": "[parameters('environment')]"
    },
    "isAz": "[endsWith(parameters('gatewaySku'), 'AZ')]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-05-01",
      "name": "[format('pip-{0}-vpngw-{1}', parameters('namePrefix'), parameters('environment'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Standard",
        "tier": "Regional"
      },
      "zones": "[if(variables('isAz'), createArray('1', '2', '3'), createArray())]",
      "properties": {
        "publicIPAllocationMethod": "Static"
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworkGateways",
      "apiVersion": "2024-05-01",
      "name": "[format('vgw-{0}-{1}', parameters('namePrefix'), parameters('environment'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "gatewayType": "Vpn",
        "vpnType": "RouteBased",
        "vpnGatewayGeneration": "[parameters('gatewayGeneration')]",
        "enableBgp": false,
        "sku": {
          "name": "[parameters('gatewaySku')]",
          "tier": "[parameters('gatewaySku')]"
        },
        "ipConfigurations": [
          {
            "name": "default",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', format('pip-{0}-vpngw-{1}', parameters('namePrefix'), parameters('environment')))]"
              },
              "subnet": {
                "id": "[parameters('gatewaySubnetId')]"
              }
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', format('pip-{0}-vpngw-{1}', parameters('namePrefix'), parameters('environment')))]"
      ]
    }
  ],
  "outputs": {
    "gatewayName": {
      "type": "string",
      "value": "[format('vgw-{0}-{1}', parameters('namePrefix'), parameters('environment'))]"
    },
    "gatewayId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworkGateways', format('vgw-{0}-{1}', parameters('namePrefix'), parameters('environment')))]"
    },
    "publicIpAddress": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', format('pip-{0}-vpngw-{1}', parameters('namePrefix'), parameters('environment'))), '2024-05-01').ipAddress]"
    }
  }
}