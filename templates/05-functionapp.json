{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "18239190552399019899"
    }
  },
  "parameters": {
    "namePrefix": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "planSku": {
      "type": "string",
      "defaultValue": "Y1",
      "metadata": {
        "description": "Consumption plan SKU. Y1 is the Consumption (dynamic) plan."
      }
    },
    "linuxFxVersion": {
      "type": "string",
      "defaultValue": "Python|3.11",
      "metadata": {
        "description": "Linux runtime, for example Python|3.11"
      }
    },
    "storageAccountName": {
      "type": "string"
    },
    "docIntEndpoint": {
      "type": "string"
    },
    "incomingContainer": {
      "type": "string",
      "defaultValue": "incoming"
    },
    "resultsContainer": {
      "type": "string",
      "defaultValue": "results"
    },
    "defaultModel": {
      "type": "string",
      "defaultValue": "prebuilt-invoice"
    },
    "availableModels": {
      "type": "string",
      "defaultValue": "prebuilt-invoice,prebuilt-receipt,prebuilt-idDocument,prebuilt-layout,prebuilt-read"
    },
    "maxUploadMb": {
      "type": "int",
      "defaultValue": 20,
      "minValue": 1,
      "maxValue": 100
    }
  },
  "variables": {
    "tags": {
      "project": "[parameters('namePrefix')]",
      "environment": "[parameters('environment')]"
    },
    "suffix": "[take(uniqueString(resourceGroup().id), 5)]",
    "appName": "[toLower(format('func-{0}-{1}-{2}', take(parameters('namePrefix'), 12), take(parameters('environment'), 3), variables('suffix')))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[format('asp-{0}-{1}', parameters('namePrefix'), parameters('environment'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "functionapp",
      "sku": {
        "name": "[parameters('planSku')]",
        "tier": "Dynamic"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[variables('appName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "functionapp,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', format('asp-{0}-{1}', parameters('namePrefix'), parameters('environment')))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "[parameters('linuxFxVersion')]",
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "appSettings": [
            {
              "name": "AzureWebJobsStorage",
              "value": "[format('DefaultEndpointsProtocol=https;AccountName={0};AccountKey={1};EndpointSuffix={2}', parameters('storageAccountName'), listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2023-05-01').keys[0].value, environment().suffixes.storage)]"
            },
            {
              "name": "WEBSITE_CONTENTAZUREFILECONNECTIONSTRING",
              "value": "[format('DefaultEndpointsProtocol=https;AccountName={0};AccountKey={1};EndpointSuffix={2}', parameters('storageAccountName'), listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2023-05-01').keys[0].value, environment().suffixes.storage)]"
            },
            {
              "name": "WEBSITE_CONTENTSHARE",
              "value": "[variables('appName')]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "python"
            },
            {
              "name": "SCM_DO_BUILD_DURING_DEPLOYMENT",
              "value": "true"
            },
            {
              "name": "ENABLE_ORYX_BUILD",
              "value": "true"
            },
            {
              "name": "DOCINT_ENDPOINT",
              "value": "[parameters('docIntEndpoint')]"
            },
            {
              "name": "STORAGE_ACCOUNT_URL",
              "value": "[format('https://{0}.blob.{1}', parameters('storageAccountName'), environment().suffixes.storage)]"
            },
            {
              "name": "INCOMING_CONTAINER",
              "value": "[parameters('incomingContainer')]"
            },
            {
              "name": "RESULTS_CONTAINER",
              "value": "[parameters('resultsContainer')]"
            },
            {
              "name": "DEFAULT_MODEL",
              "value": "[parameters('defaultModel')]"
            },
            {
              "name": "AVAILABLE_MODELS",
              "value": "[parameters('availableModels')]"
            },
            {
              "name": "MAX_UPLOAD_MB",
              "value": "[string(parameters('maxUploadMb'))]"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', format('asp-{0}-{1}', parameters('namePrefix'), parameters('environment')))]"
      ]
    }
  ],
  "outputs": {
    "functionAppName": {
      "type": "string",
      "value": "[variables('appName')]"
    },
    "functionAppId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/sites', variables('appName'))]"
    },
    "principalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', variables('appName')), '2023-12-01', 'full').identity.principalId]"
    },
    "defaultHostName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', variables('appName')), '2023-12-01').defaultHostName]"
    }
  }
}