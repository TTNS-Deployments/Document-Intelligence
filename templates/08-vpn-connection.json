{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "1944881539741628612"
    }
  },
  "parameters": {
    "namePrefix": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "localGatewayId": {
      "type": "string"
    },
    "remoteGatewayId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the remote VPN gateway (can be in another resource group or subscription)."
      }
    },
    "sharedKey": {
      "type": "securestring"
    }
  },
  "variables": {
    "tags": {
      "project": "[parameters('namePrefix')]",
      "environment": "[parameters('environment')]"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/connections",
      "apiVersion": "2024-05-01",
      "name": "[format('cn-{0}-{1}-to-remote', parameters('namePrefix'), parameters('environment'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "properties": {
        "connectionType": "Vnet2Vnet",
        "virtualNetworkGateway1": {
          "id": "[parameters('localGatewayId')]",
          "properties": {}
        },
        "virtualNetworkGateway2": {
          "id": "[parameters('remoteGatewayId')]",
          "properties": {}
        },
        "sharedKey": "[parameters('sharedKey')]",
        "enableBgp": false,
        "routingWeight": 10
      }
    }
  ],
  "outputs": {
    "connectionName": {
      "type": "string",
      "value": "[format('cn-{0}-{1}-to-remote', parameters('namePrefix'), parameters('environment'))]"
    }
  }
